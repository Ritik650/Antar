# Copy to .env and fill in. Never commit .env.
#
# Antar runs end to end with all of these blank: the simulator supplies the event
# stream, the LLM drafter falls back to deterministic templates, and the ledger
# uses SQLite. Keys only unlock the live-integration paths.

# --- Razorpay (test mode only; keys must start rzp_test_) -------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Anthropic --------------------------------------------------------------
# Without this the drafter uses the deterministic template filler and every
# draft is flagged fallback_used=true in the audit trace.
ANTHROPIC_API_KEY=

# --- Infrastructure ---------------------------------------------------------
# Defaults to SQLite so `make evaluate` works with no Docker.
ANTAR__STORAGE__DATABASE_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Behaviour --------------------------------------------------------------
# Set to false only with a real merchant policy profile loaded and eyes open.
ANTAR__GATE__DRY_RUN=true
ANTAR__ACT__LLM__ENABLED=false
