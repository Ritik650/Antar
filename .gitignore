.env
config/local.yaml

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# `artifacts/*` rather than `artifacts/`: git cannot re-include a file inside an
# excluded *directory*, so the directory has to stay walkable for the negations below
# to work at all.
artifacts/*
!artifacts/.gitkeep
# Published for review, and the JSON is the load-bearing part.
#
# The README's N4 promise is that every number in it is reproducible, and
# `tests/statistical/test_results_are_reproducible.py` checks each one against these
# files. Excluding them meant a reviewer who cloned the repo could verify neither: the
# README cited `allocation_base.json` and `claims.json` and the clone did not contain
# them, and two headline figures appeared in no committed artifact at all. A guard whose
# evidence is missing from the repository is a guard nobody outside can run.
#
# 317 KB for the whole set. The 13 MB ledger database and the coverage XML stay out -
# the first is regenerable bulk, the second is CI output.
!artifacts/RESULTS.md
!artifacts/*.json
artifacts/coverage.xml
!artifacts/calibration.md
!artifacts/figures/
artifacts/figures/*
!artifacts/figures/*.png

.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# Local throwaway experiments; never part of a milestone.
.scratch/

# Preparation material, not part of the submission. These stay on disk and out of
# the repository: the build plan, a video script and rehearsal notes are working
# documents, not project artifacts.
PLAN.md
docs/VIDEO.md
docs/PANEL_DEFENCE.md
docs/SUBMISSION.md
