.env
config/local.yaml

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# `artifacts/*` rather than `artifacts/`: git cannot re-include a file inside an
# excluded *directory*, so the directory has to stay walkable for the negations below
# to work at all.
artifacts/*
!artifacts/.gitkeep
# Published for review: generated by `python tasks.py evaluate`, committed so a
# reviewer can see the results and the figures without a 40-minute run. Everything
# else under artifacts/ - databases, intermediate JSON - stays local.
!artifacts/RESULTS.md
!artifacts/figures/
artifacts/figures/*
!artifacts/figures/*.png

.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# Local throwaway experiments; never part of a milestone.
.scratch/

# Preparation material, not part of the submission. These stay on disk and out of
# the repository: the build plan, a video script and rehearsal notes are working
# documents, not project artifacts.
PLAN.md
docs/VIDEO.md
docs/PANEL_DEFENCE.md
docs/SUBMISSION.md
